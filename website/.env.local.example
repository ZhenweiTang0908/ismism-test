NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANSWERS_TABLE=ismsim-answers
SUPABASE_RESULTS_TABLE=ismism-result
SUPABASE_CLIENT_TABLE=ismism-client

# Interpretations are served from data/preset-interpretations.json.
# Set the flag below to "true" to re-enable live AI calls (only used when a preset is missing).
AI_INTERPRETATION_FALLBACK_ENABLED=false

# Optional: AI interpretation provider (only used when the fallback flag is true)
SILICONCLOUD_API_KEY=
SILICONCLOUD_BASE_URL=https://api.siliconflow.cn/v1
SILICONCLOUD_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Fallback OpenAI-compatible provider (used when SiliconCloud fails)
ONEYUAN_API_KEY=
ONEYUAN_API_BASE_URL=https://1yuanapi.com/v1
